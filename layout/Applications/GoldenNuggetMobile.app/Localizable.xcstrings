    "Catalogs are cached for %lld minutes; the reload button throws the cache away and asks again. Previews are cached until iOS reclaims them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录缓存 %1$lld 分钟；点重新加载会丢弃缓存并重新请求。预览会一直缓存，直到 iOS 回收它们。"
          }
        }
      }
    },
