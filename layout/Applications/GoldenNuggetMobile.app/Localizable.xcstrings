    "the iOS 27 archive": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27 归档"
          }
        }
      }
    },
    "tunnel: %@ · peer %@:%u reachable: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "tunnel: %1$@ · peer %2$@:%3$u reachable: %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道：%1$@ · 对端 %2$@:%3$u 可达：%4$@"
          }
        }
      }
    },
    "value": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "值"
          }
        }
      }
    },
    "working…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中…"
          }
        }
      }
    },
    "≈ %@ remaining": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩约 %1$@"
          }
        }
      }
    },
    "≈ %lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %1$lld 分钟"
          }
        }
      }
    },
    "⚠ Low battery: %lld%%. Connect the charger before restoring.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ 电量低：%1$lld%%，请在还原前连接充电器。"
          }
        }
      }
    },
    "⚠ Low storage: %.1f GB free. Restoring tweaks may require at least %.1f GB free and could fail if the device runs out of space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "⚠ Low storage: %1$.1f GB free. Restoring tweaks may require at least %2$.1f GB free and could fail if the device runs out of space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ 存储空间不足：剩余 %1$.1f GB。还原改机项可能至少需要 %2$.1f GB 可用空间，设备空间不足时可能会失败。"
          }
        }
      }
    },
    "⚠️ A PosterBoard reset is armed (%@). A reset run clears the store and installs no wallpapers, so with wallpapers selected as well Apply refuses until one of the two is turned off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ PosterBoard 重置已就绪（%1$@）。重置运行会清空存储且不安装任何壁纸，因此如果同时还选了壁纸，应用将拒绝执行，直到其中一个被关闭。"
          }
        }
      }
    }
  },
  "version": "1.0"
}