    "saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存"
          }
        }
      }
    },
    "statusBarOverrides struct, so every override reads as off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "statusBarOverrides 结构体，因此每个覆盖项都会被读作关闭。"
          }
        }
      }
    },
    "the classic struct": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经典结构体"
          }
        }
      }
