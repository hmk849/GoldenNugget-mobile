{
  "sourceLanguage": "en",
  "strings": {
    "%@  •  %@  •  %@  •  iOS %@  •  %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  •  %2$@  •  %3$@  •  iOS %4$@  •  %5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  •  %2$@  •  %3$@  •  iOS %4$@  •  %5$@"
          }
        }
      }
    },
    "%@ (%lld/%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld/%3$lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld/%3$lld）"
          }
        }
      }
    },
    "%@ (%llu KB)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$llu KB)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$llu KB）"
          }
        }
      }
    },
    "%@ has nothing in it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 里是空的。"
          }
        }
      }
    },
    "%@ on the device, removed with no trash and no undo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备上的 %1$@，删除后没有回收站、无法撤销。"
          }
        }
      }
    },
    "%@ uses the legacy %@ format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ uses the legacy %2$@ format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用旧版 %2$@ 格式。"
          }
        }
      }
    },
    "%@ will be copied into this app's container. Files larger than 64 MiB will also stay on the device. Free space there: %@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ will be copied into this app's container. Files larger than 64 MiB will also stay on the device. Free space there: %2$@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将被复制到本 App 的容器中。大于 64 MiB 的文件也会保留在设备上。该处可用空间：%2$@。一旦删除，容器中的副本就是唯一一份——而卸载 App 时容器会被删除。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ — %lld file(s), %lld key(s) found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — %2$lld file(s), %3$lld key(s) found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — 找到 %2$lld 个文件、%3$lld 个键。"
          }
        }
      }
    },
    "%lld file(s), %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld file(s), %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个文件，%2$@"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个文件"
          }
        }
      }
    },
    "%lld of %lld applicable tweak(s) enabled. Incompatible and un-ported tweaks are hidden, the same way the reference hides them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld applicable tweak(s) enabled. Incompatible and un-ported tweaks are hidden, the same way the reference hides them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用 %1$lld/%2$lld 个适用改机项。不兼容和未移植的改机项会被隐藏，与原版一致。"
          }
        }
      }
    },
    "%lld of %lld daemon group(s) on. The groups upstream marks interface-visible but gives no switch are in the Recommended set only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld daemon group(s) on. The groups upstream marks interface-visible but gives no switch are in the Recommended set only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 个守护进程组已开启。上游标记为界面可见但不提供开关的组仅包含在推荐组合中。"
          }
        }
      }
    },
    "%lld operations found": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 %1$lld 个操作"
          }
        }
      }
    },
    "%lld override(s) → %@, written on the next Apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld override(s) → %2$@, written on the next Apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个覆盖项 → %2$@，将在下次应用时写入。"
          }
        }
      }
    },
    "%lld photo(s) and video(s) — %@ kept in the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld photo(s) and video(s) — %2$@ kept in the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 张照片和视频——%2$@ 保留在 App 内"
          }
        }
      }
    },
    "(empty = clear)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（留空 = 清除）"
          }
        }
      }
    },
    ", %lld symlink(s) skipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，已跳过 %1$lld 个符号链接"
          }
        }
      }
    },
    "1 file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个文件"
          }
        }
      }
    },
    "1 · Tunnel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · 隧道"
          }
        }
      }
    },
    "1. SysSharedContainerDomain-systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist, %lld setup panes marked skipped;": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. SysSharedContainerDomain-systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist，%1$lld 个设置面板已标记为跳过；"
          }
        }
      }
    },
    "2 · Pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · 配对"
          }
        }
      }
    },
    "2. ManagedPreferencesDomain/mobile/com.apple.purplebuddy.plist, setup marked done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ManagedPreferencesDomain/mobile/com.apple.purplebuddy.plist，设置已标记为完成。"
          }
        }
      }
    },
    "A folder. Nothing goes through a trash here — this is the device's own delete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个文件夹。这里没有回收站——这是设备自身的删除操作。"
          }
        }
      }
    },
    "A video that carries a rotation transform is decoded in its stored orientation, which is what the reference's decoder does; such a clip may appear rotated on the Lock Screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带有旋转信息的视频将按其存储方向解码，与原版解码器的行为一致；这类视频在锁屏上可能显示为旋转状态。"
          }
        }
      }
    },
    "A wallpaper exists in two places at once — its descriptor files, and three rows in the store's own sqlite. The rows carry the device's provider registrations and the metadata the picker sorts by, so they cannot be invented: the apply fetches the store from the device first and adds rows to a copy of it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张壁纸同时存在于两处——描述文件，以及商店自身 sqlite 数据库中的三行数据。这些行包含设备的提供方注册信息和选择器排序用的元数据，无法凭空编造：应用时先从设备获取商店数据，再向其副本中添加行。"
          }
        }
      }
    },
    "AAR handling": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AAR 处理"
          }
        }
      }
    },
